// Prisma schema (PostgreSQL: Neon in production, any Postgres locally).
// JSON values are stored as strings, as they were when the app used SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  name              String?
  profile           String   // JSON string of the user profile
  isVerified        Boolean  @default(false)
  verificationToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mealPlans       MealPlan[]
  compliance      Compliance[]
  weightLogs      WeightLog[]
  hydrationLogs   HydrationLog[]
  favoriteRecipes FavoriteRecipe[]
  customRecipes   Recipe[]
  data            UserData[]
  foodLogs        FoodLog[]
  aiUsage         AiUsage[]
  checkIns        CheckIn[]
  coachMessages   CoachMessage[]
  pantryItems     PantryItem[]
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime
  version   Int      @default(1) // planner version that generated it
  planData  String   // JSON string of the plan
  createdAt DateTime @default(now())
}

model Compliance {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id])
  date   String // Storing as YYYY-MM-DD string for easy matching
  meals  String // JSON string of meal status

  @@unique([userId, date])
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model HydrationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD for easy daily aggregation
  amount    Int      // in ml
  createdAt DateTime @default(now())
}

model FavoriteRecipe {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    String   // JSON string of the full recipe object
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

// Small per-user documents that used to live only in the browser
// (pantry, ticked shopping items, streak badges, chosen plan archetype).
model UserData {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String   // JSON string
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// Ingredient catalogue. Nutrients are per 100 g edible portion (IFCT 2017 where available).
model Food {
  id        String  @id // catalogue key, e.g. "toor_dal"
  name      String
  source    String  // "IFCT 2017 B021", "USDA FDC 171284", ...
  foodGroup String
  kcal      Float
  protein   Float
  carbs     Float   // available carbohydrate
  fat       Float
  fibre     Float
  sugar     Float
  sodium    Float   // mg
  iron      Float   // mg
  calcium   Float   // mg
  vitC      Float   // mg
  folate    Float   // µg
  gi        Float?
  priceInr  Float?  // ₹ per kg
  allergens String  // JSON array
  flags     String  // JSON array
  animal    String?
  unitName  String?
  unitGrams Float?

  recipeIngredients RecipeIngredient[]
}

// Curated recipes (ownerId null) and users' own recipes.
// Curated nutrition is computed from the ingredients; custom recipes may be typed in.
model Recipe {
  id            String   @id
  ownerId       Int?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source        String   @default("curated") // "curated" | "custom"
  name          String
  course        String   // staple | main | complete | breakfast | snack
  cuisine       String
  meals         String   // JSON array of meal slots
  regions       String   // JSON array of Indian states
  pairs         String   // JSON array of staple groups (mains)
  stapleGroup   String?
  servings      Int
  servingUnit   String
  prepTime      Int
  cookTime      Int
  difficulty    String
  tags          String   // JSON array
  instructions  String   // JSON array
  batchFriendly Boolean  @default(false)
  imageUrl      String?

  // Per-serving values
  kcal          Float
  protein       Float
  carbs         Float
  fat           Float
  fibre         Float
  sugar         Float
  sodium        Float
  iron          Float
  calcium       Float
  vitC          Float
  folate        Float
  glycaemicLoad Float
  costInr       Float
  allergens     String   // JSON array
  dietCategory  String   // vegan | vegetarian | eggetarian | pescatarian | non_veg
  flags         String   // JSON object: jainSafe, vratSafe, noOnionGarlic, ...
  customIngredients String? // JSON array of display strings (custom recipes only)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ingredients   RecipeIngredient[]

  @@index([course])
  @@index([ownerId])
}

model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id])
  grams    Float  // for the whole recipe
  position Int
}

// What the user actually ate. Nutrient totals are always computed on the server from
// Recipe / Food rows; the AI only identifies dishes and portions.
model FoodLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD (user's local date)
  slot      String   // breakfast | lunch | snack | dinner
  source    String   // plan | photo | text | manual
  items     String   // JSON array: { kind, refId, name, quantity, unit, servings?, grams?, nutrition }
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  fibre     Float
  sugar     Float
  sodium    Float
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Gemini calls per user per day, for the free-tier quota.
model AiUsage {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD (UTC)
  count  Int    @default(0)

  @@unique([userId, date])
}

// Weekly adaptive-target check-ins (F2).
model CheckIn {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  formulaTdee  Int
  observedTdee Int?
  appliedTdee  Int
  oldTarget    Int
  newTarget    Int
  details      String   // JSON: the engine's full result
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

// AI coach conversation (F7). Assistant messages may carry proposed plan changes or food
// logs that only take effect when the user applies them.
model CoachMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user | assistant
  content   String
  proposals String?  // JSON array: { action, title, status, changes, payload, ... }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Retail prices per food and city tier (F5). Seeded from data/prices.js: government
// (DoCA) averages where published, estimates otherwise; `source` says which.
model IngredientPrice {
  id       Int     @id @default(autoincrement())
  foodId   String
  tier     String  // metro | tier2
  priceInr Float   // ₹ per kg (per litre for liquids)
  source   String
  asOf     String? // YYYY-MM-DD of the source data

  @@unique([foodId, tier])
}

// What the user already has at home (F5). grams null means "have enough".
model PantryItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  grams     Float?
  expiresOn String?  // YYYY-MM-DD
  updatedAt DateTime @updatedAt

  @@unique([userId, foodId])
}
